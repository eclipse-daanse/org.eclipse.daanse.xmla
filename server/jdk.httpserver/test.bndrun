	org.eclipse.daanse.xmla.model.rowset;version='[0.0.1,0.0.2)',\
	org.eclipse.daanse.xmla.model.soap;version='[0.0.1,0.0.2)',\
	org.eclipse.daanse.xmla.model.xmla;version='[0.0.1,0.0.2)',\
